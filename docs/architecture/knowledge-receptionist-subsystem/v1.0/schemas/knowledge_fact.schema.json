{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EveryCall Knowledge Fact",
  "description": "Atomic evidence-backed claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_fact_id",
    "tenant_id",
    "build_id",
    "domain_id",
    "fact_type",
    "object_type",
    "subject",
    "predicate",
    "object",
    "normalized_value",
    "confidence",
    "source_ref_ids",
    "scope",
    "content_class"
  ],
  "properties": {
    "knowledge_fact_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    },
    "domain_id": {
      "type": "string"
    },
    "subdomain_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fact_type": {
      "type": "string"
    },
    "object_type": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "object": {},
    "normalized_value": {},
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_ref_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": true
    },
    "content_class": {
      "type": "string",
      "enum": [
        "operational_core",
        "policy_boundary",
        "descriptive",
        "marketing",
        "educational"
      ]
    }
  }
}
