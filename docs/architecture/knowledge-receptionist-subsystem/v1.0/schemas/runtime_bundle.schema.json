{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EveryCall Runtime Bundle",
  "description": "Per-turn truth surface for Realtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_bundle_id",
    "call_id",
    "turn_id",
    "tenant_id",
    "active_domain_id",
    "active_subdomain_id",
    "detected_turn_intent",
    "selected_card_ids",
    "selected_cards",
    "state_delta",
    "missing_slots",
    "mode",
    "response_rules",
    "confidence",
    "created_at"
  ],
  "properties": {
    "runtime_bundle_id": {
      "type": "string"
    },
    "call_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "active_domain_id": {
      "type": "string"
    },
    "active_subdomain_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "detected_turn_intent": {
      "type": "string"
    },
    "selected_card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_cards": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "state_delta": {
      "type": "object",
      "additionalProperties": true
    },
    "missing_slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "answer",
        "partial_answer",
        "clarify",
        "handoff",
        "emergency_redirect"
      ]
    },
    "response_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string"
    }
  }
}
