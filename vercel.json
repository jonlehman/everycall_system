{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "corepack pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "corepack pnpm build",
  "crons": [
    {
      "path": "/api/cron/knowledge-builds",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/demo-sessions",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/billing-lifecycle",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/cron/sales-maintenance",
      "schedule": "*/1 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "/api/v1/$1"
    }
  ]
}
