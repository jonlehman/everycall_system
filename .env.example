# Shared
NODE_ENV=development
DATABASE_URL=postgres://user:password@host:5432/everycall
CONFIG_API_KEY=change_me_for_prod
MAILTRAP_TOKEN=your_mailtrap_token
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co
MAILTRAP_SENDER_NAME=EveryCall
ADMIN_BOOTSTRAP_EMAIL=admin@everycall.io
ADMIN_BOOTSTRAP_PASSWORD=change_me
APP_BASE_URL=https://everycallsystem.vercel.app

# call-gateway
PORT=3101
TELNYX_PUBLIC_KEY=your_telnyx_public_key
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_TRANSCRIPTION_MODEL=Telnyx
CALL_GATEWAY_BASE_URL=https://everycall-call-gateway.onrender.com
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_INPUT_FORMAT=g711_ulaw
OPENAI_REALTIME_OUTPUT_FORMAT=g711_ulaw
TELNYX_RTP_PAYLOAD_TYPE=0
TELNYX_BIDIRECTIONAL_PAYLOAD_MODE=raw

# summaries
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SUMMARY_MODEL=gpt-5.2
