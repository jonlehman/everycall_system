# Shared
NODE_ENV=development
DATABASE_URL=postgres://user:password@host:5432/everycall
# Optional. Useful for single-connection local database fixtures; production defaults to 10.
DATABASE_POOL_MAX=
CONFIG_API_KEY=change_me_for_prod
MAILTRAP_TOKEN=your_mailtrap_token
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co
MAILTRAP_SENDER_NAME=EveryCall
ADMIN_BOOTSTRAP_EMAIL=admin@everycall.io
ADMIN_BOOTSTRAP_PASSWORD=change_me
APP_BASE_URL=https://everycallsystem.vercel.app
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_WEBHOOK_SECRET_PREVIOUS=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
STRIPE_CURRENCY=usd
STRIPE_DEFAULT_PRODUCT_ID=
STRIPE_STARTER_PRODUCT_ID=
STRIPE_STARTER_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_GROWTH_PRODUCT_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_GROWTH_ANNUAL_PRICE_ID=
STRIPE_PRO_PRODUCT_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
DEFAULT_TRIAL_DAYS=30
CRON_SECRET=change_me
INTERNAL_SERVICE_SECRET=change_me
INTEGRATION_SECRET_ENCRYPTION_KEY=change_me

# admin marketing insights
MICROSOFT_CLARITY_API_TOKEN=
GOOGLE_ADS_API_VERSION=v24
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_MCP_URL=https://googleads-mcp.vercel.app/api/mcp
GOOGLE_ADS_MCP_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# call-gateway
PORT=3101
TELNYX_PUBLIC_KEY=your_telnyx_public_key
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_VOICE_CONNECTION_ID=your_telnyx_voice_connection_id
TELNYX_TRANSCRIPTION_MODEL=Telnyx
CALL_GATEWAY_BASE_URL=https://everycall-call-gateway.onrender.com
CALL_SUMMARY_TOKEN=legacy_internal_secret_fallback
XAI_API_KEY=your_xai_api_key
XAI_REALTIME_AUDIO_RATE_PER_MINUTE_USD=0.05
TELNYX_RTP_PAYLOAD_TYPE=0
TELNYX_BIDIRECTIONAL_PAYLOAD_MODE=raw

# summaries
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SUMMARY_MODEL=gpt-5.2

# knowledge builds
KNOWLEDGE_BUILD_MAX_WEBSITE_PAGES=360
KNOWLEDGE_BUILD_MAX_COMPILE_SOURCES=360
KNOWLEDGE_BUILD_JOB_MAX_AUTO_RESUME_AGE_MINUTES=360

# public website demos
DEMO_SESSION_TTL_DAYS=30

# outbound sales console (Vercel)
SALES_OUTBOUND_ENABLED=false
SALES_CALL_GATEWAY_BASE_URL=https://everycall-sales-call-gateway.onrender.com
SALES_SIGNUP_TOKEN_SECRET=replace_with_at_least_32_random_characters
SALES_SIGNUP_INVITE_TTL_MINUTES=60
# Operational local-time gate for starting sales calls. Start is inclusive,
# end is exclusive; setting both to the same value allows calls all day.
SALES_CALL_WINDOW_START_LOCAL=08:00
SALES_CALL_WINDOW_END_LOCAL=20:00
# `block` (default) requires an IANA timezone; `allow` explicitly permits
# legacy records without one. Invalid supplied timezones are always blocked.
SALES_CALL_MISSING_TIMEZONE_POLICY=block
SALES_TELNYX_API_KEY=your_dedicated_sales_telnyx_api_key
SALES_TELNYX_TELEPHONY_CREDENTIAL_ID=your_dedicated_sales_webrtc_credential_id
# Optional per-admin override: {"1":"credential-id-for-admin-1"}
SALES_TELNYX_TELEPHONY_CREDENTIALS_JSON=
SALES_TELNYX_CALLER_ID=+15555550100
SMARTLEAD_API_KEY=your_smartlead_api_key
SMARTLEAD_SALES_NO_ANSWER_CAMPAIGN_ID=
SMARTLEAD_SALES_VOICEMAIL_CAMPAIGN_ID=
SMARTLEAD_SALES_CALLBACK_CAMPAIGN_ID=
SMARTLEAD_SALES_CONNECTED_CAMPAIGN_ID=
SMARTLEAD_SALES_DEMO_CAMPAIGN_ID=
SMARTLEAD_SALES_WEBHOOK_SECRET=replace_with_a_random_webhook_secret

# isolated outbound sales call gateway (Render)
SALES_DATABASE_POOL_MAX=5
SALES_TELNYX_PUBLIC_KEY=your_dedicated_sales_telnyx_public_key
SALES_TELNYX_CALL_CONTROL_APP_ID=your_dedicated_sales_call_control_application_id
SALES_TELNYX_OPERATOR_CONNECTION_ID=your_dedicated_sales_credential_connection_id
SALES_TELNYX_SIGNATURE_REQUIRED=true
SALES_TELNYX_HTTP_TIMEOUT_MS=8000
SALES_PROVIDER_EVENT_RECOVERY_INTERVAL_MS=30000
SALES_AI_DEMO_MAX_SECONDS=600
SALES_XAI_API_KEY=your_dedicated_sales_xai_api_key
SALES_XAI_PHONE_NUMBER=+18005550199
SALES_XAI_WEBHOOK_SECRET=your_xai_phone_number_webhook_secret
SALES_XAI_SIGNATURE_REQUIRED=true
SALES_XAI_HTTP_TIMEOUT_MS=8000
SALES_XAI_REALTIME_VOICE=eve
SALES_XAI_TRANSCRIPTION_MODEL=grok-transcribe
