{
  "name": "everycall",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm exec tsc -p packages/contracts/tsconfig.json && next build",
    "start": "next start",
    "db:migrate": "node scripts/migrate.mjs",
    "validate:billing-catalog": "node scripts/validate-billing-catalog.mjs",
    "validate:demo-realtime-session": "node --no-warnings scripts/validate-demo-realtime-session.mjs",
    "validate:knowledge-receptionist-cutover": "node scripts/validate-knowledge-receptionist-cutover.mjs",
    "validate:xai-realtime-payloads": "node scripts/validate-xai-realtime-payloads.mjs",
    "validate:voice-runtime-hardening": "node scripts/validate-voice-runtime-hardening.mjs",
    "typecheck": "pnpm -r typecheck",
    "dev:call-gateway": "PORT=3101 pnpm --filter @everycall/call-gateway dev",
    "dev:sales-call-gateway": "PORT=3102 pnpm --filter @everycall/sales-call-gateway dev",
    "validate:sales-system": "node --no-warnings scripts/validate-sales-data.mjs && node --no-warnings scripts/validate-sales-database.mjs && node --no-warnings scripts/validate-sales-smartlead.mjs && node --no-warnings scripts/validate-sales-webrtc.mjs && node --no-warnings scripts/validate-sales-gateway-client.mjs && node --no-warnings scripts/validate-sales-telephony.mjs && pnpm --filter @everycall/sales-call-gateway validate",
    "smoke": "node scripts/smoke.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:client-ui:v2:e2e": "node scripts/test-client-ui-v2-e2e.mjs",
    "validate:client-setup-status": "node scripts/validate-client-setup-status.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@everycall/contracts": "workspace:*",
    "@mui/material": "^7.3.8",
    "@mui/x-data-grid": "^8.27.3",
    "@telnyx/webrtc": "^2.27.8",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.576.0",
    "mailtrap": "^3.4.0",
    "next": "16.1.6",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-socket": "0.2.7",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
